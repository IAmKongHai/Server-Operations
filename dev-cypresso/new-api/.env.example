# new-api @ dev-cypresso 环境变量模板
#
# 服务器上的真实文件是 /home/ec2-user/stacks/new-api/.env（chmod 600）。
# 本文件只作对照，所有 <generated> 占位符都必须用 CSPRNG 现生成，不得沿用示例值：
#   openssl rand -hex 32
# 生成后的真实值记录在本地 gitignore 的 dev-cypresso/secrets.local.md。

# ---- 数据库：复用 infra 栈的 shared-postgres，独立库独立角色（KTD1） ----
# 主机名 shared-postgres 由 shared-services 网络的 Docker DNS 解析
SQL_DSN=postgresql://new_api:<generated>@shared-postgres:5432/new_api

# 连接池压低，避免撑爆共享库 max_connections=100（KTD9，配合角色 CONNECTION LIMIT 30）
SQL_MAX_OPEN_CONNS=20
SQL_MAX_IDLE_CONNS=5

# ---- Redis：new-api 专用实例，不复用 shared-redis（KTD2） ----
# REDIS_PASSWORD 同时供 redis-server --requirepass 与下面的连接串使用，两处必须一致
REDIS_PASSWORD=<generated>
REDIS_CONN_STRING=redis://:<generated>@new-api-redis:6379/0

# ---- 会话与加密密钥（KTD13） ----
# 两者独立生成：CRYPTO_SECRET 缺省会回退到 SESSION_SECRET，
# 届时轮换会话密钥会连带让已加密的渠道密钥不可解密。
# 首次部署设定后即视为不可随意轮换（R10）。
SESSION_SECRET=<generated>
CRYPTO_SECRET=<generated>

# ---- Cookie 与反代（R11、R12） ----
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://zzz.konghai.me
# 宿主 Nginx 经 docker-proxy 到达容器时来源是 Docker 网关（172.x.0.1），不是 127.0.0.1。
# 填 127.0.0.1 会让 ClientIP() 退化为网关 IP，按 IP 的限流与审计全部失真（KTD6）。
# U4 会实测两个网络的网关，若不落在此网段内需按实际值改写。
TRUSTED_PROXIES=172.16.0.0/12

# ---- 运行参数 ----
NODE_NAME=new-api-dev-cypresso-1
TZ=Asia/Shanghai
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
# 流式空闲超时，需不高于 Nginx 的 proxy_read_timeout 600s
STREAMING_TIMEOUT=300
