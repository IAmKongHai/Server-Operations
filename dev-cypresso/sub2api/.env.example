# sub2api @ dev-cypresso 环境变量模板
#
# 服务器上的真实文件是 /home/ec2-user/stacks/sub2api/.env（chmod 600）。
# 本文件只作对照，所有 <generated> 占位符都必须用 CSPRNG 现生成，不得沿用示例值：
#   openssl rand -hex 32
# 生成后的真实值记录在本地 gitignore 的 dev-cypresso/secrets.local.md。

# ---- 数据库：复用 infra 栈的 shared-postgres，独立库独立角色 ----
# 主机名 shared-postgres 由 shared-services 网络的 Docker DNS 解析
DATABASE_HOST=shared-postgres
DATABASE_PORT=5432
DATABASE_USER=sub2api
DATABASE_PASSWORD=<generated>
DATABASE_DBNAME=sub2api
DATABASE_SSLMODE=disable
# 连接池压低，避免撑爆共享库 max_connections=100。角色 CONNECTION LIMIT 20
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

# ---- Redis：sub2api 专用实例，不复用 shared-redis ----
# REDIS_PASSWORD 同时供 redis-server --requirepass 与应用连接使用，两处必须一致
REDIS_HOST=sub2api-redis
REDIS_PORT=6379
REDIS_PASSWORD=<generated>
REDIS_DB=0
REDIS_POOL_SIZE=32
REDIS_MIN_IDLE_CONNS=4
REDIS_ENABLE_TLS=false

# ---- 应用 ----
AUTO_SETUP=true
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai
ADMIN_EMAIL=konghai007@gmail.com
ADMIN_PASSWORD=<generated>
# 首次部署设定后不可随意轮换：JWT 轮换会踢掉登录，TOTP 轮换会让已绑定的 2FA 失效
JWT_SECRET=<generated>
JWT_EXPIRE_HOUR=24
TOTP_ENCRYPTION_KEY=<generated>

# 宿主 Nginx 经 docker-proxy 到达容器时来源是 Docker 网关（172.x.0.1），不是 127.0.0.1
SERVER_TRUSTED_PROXIES=172.16.0.0/12
# 新装关闭原始转发头接管，只信上面的代理网段
SECURITY_TRUST_FORWARDED_IP_FOR_API_KEY_ACL=false
SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=false
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false
