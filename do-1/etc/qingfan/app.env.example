# /etc/qingfan/app.env (chown root:qingfan, chmod 0640)
QINGFAN_DATA=/var/lib/qingfan
QINGFAN_DATABASE_URL=postgres://qingfan:<PASSWORD>@<MANAGED_PG_PRIVATE_HOST>:25060/qingfan?sslmode=require
QINGFAN_ADMIN_ORIGIN=https://qingfan.konghai.me
QINGFAN_COLLECTOR_KEY=<COLLECTOR_KEY>
# Keep each of qingfan's 3 internal DB pools at 1 connection (3 total per instance)
# so the 25-connection Managed PG cluster has plenty of headroom during Blue-Green switches.
QINGFAN_DB_MAX_CONNS=1
