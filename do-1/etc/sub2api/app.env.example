# Copy to /etc/sub2api/app.env (chown root:sub2api, chmod 0640)
GIN_MODE=release
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai

# Shared persistent directory across blue/green slots (stores .installed and config.yaml)
DATA_DIR=/var/lib/sub2api/data
AUTO_SETUP=true

# Managed PostgreSQL 18 (VPC private host, port 25060)
DATABASE_HOST=private-db-pgsql-sfo3-95693-do-user-45140304-0.i.db.ondigitalocean.com
DATABASE_PORT=25060
DATABASE_USER=sub2api
DATABASE_PASSWORD=<PASSWORD>
DATABASE_DBNAME=sub2api
DATABASE_SSLMODE=require
# CRITICAL: DO Managed PG has max_connections=25 across all 4 apps. Keep single-instance pool <= 4!
DATABASE_MAX_OPEN_CONNS=4
DATABASE_MAX_IDLE_CONNS=2
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

# Local Redis (DB 0)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<REDIS_PASSWORD>
REDIS_DB=0
REDIS_POOL_SIZE=128
REDIS_MIN_IDLE_CONNS=5
REDIS_ENABLE_TLS=false

# Fixed secrets (REQUIRED so blue-green switches never invalidate sessions or 2FA)
JWT_SECRET=<64_HEX_RANDOM>
JWT_EXPIRE_HOUR=24
TOTP_ENCRYPTION_KEY=<64_HEX_RANDOM>
