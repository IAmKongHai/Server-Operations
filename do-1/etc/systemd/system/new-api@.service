# Template unit for Blue-Green deployment: new-api@blue.service / new-api@green.service
[Unit]
Description=New-API Gateway (%i slot)
After=network-online.target redis-server.service
Wants=network-online.target redis-server.service

[Service]
Type=simple
User=new-api
Group=new-api
WorkingDirectory=/var/lib/new-api
EnvironmentFile=/etc/new-api/app.env
EnvironmentFile=/etc/new-api/slot-%i.env
ExecStart=/opt/new-api/slots/%i/new-api --log-dir /var/log/new-api
Restart=on-failure
RestartSec=5
# Must exceed SHUTDOWN_TIMEOUT_SECONDS (120s) so SaveQuotaDataCache() finishes before SIGKILL
TimeoutStopSec=150
LimitNOFILE=100000
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/new-api /var/log/new-api

[Install]
WantedBy=multi-user.target
