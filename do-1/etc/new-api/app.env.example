# Copy to /etc/new-api/app.env (chown root:new-api, chmod 0640)
GIN_MODE=release
TZ=Asia/Shanghai

# Managed PostgreSQL 18 (VPC private host, port 25060)
SQL_DSN=postgresql://new_api:<URL_ENCODED_PASSWORD>@private-db-pgsql-sfo3-95693-do-user-45140304-0.i.db.ondigitalocean.com:25060/new_api?sslmode=require
# CRITICAL: DO Managed PG has max_connections=25 across all 4 apps. Keep single-instance pool <= 4!
SQL_MAX_OPEN_CONNS=4
SQL_MAX_IDLE_CONNS=2
SQL_MAX_LIFETIME=300

# Local Redis (DB 1 isolated from sub2api which uses DB 0)
REDIS_CONN_STRING=redis://:<REDIS_PASSWORD>@127.0.0.1:6379/1
SYNC_FREQUENCY=60

# Security & multi-instance consistency (REQUIRED for blue-green zero-logout)
SESSION_SECRET=<64_HEX_RANDOM>
CRYPTO_SECRET=<64_HEX_RANDOM>
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://tovo.sh
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Runtime & Graceful Shutdown
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
SHUTDOWN_TIMEOUT_SECONDS=120
STREAMING_TIMEOUT=300
