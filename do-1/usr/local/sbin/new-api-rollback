#!/usr/bin/env bash
# Instant Blue-Green rollback for New-API: switches back to the other slot or a specified <SHA>.
set -euo pipefail
umask 077

exec 9>/run/lock/new-api-deploy.lock
flock -n 9 || { echo 'Another new-api operation is running' >&2; exit 1; }

base=/opt/new-api
active_slot=$(tr -d '[:space:]' < "$base/active_slot" 2>/dev/null || echo "blue")

if [[ $active_slot == "blue" ]]; then
  target_slot="green"
  target_port=3002
  active_port=3001
else
  target_slot="blue"
  target_port=3001
  active_port=3002
fi

if [[ -n ${1:-} ]]; then
  target_release="$base/releases/$1"
  [[ -d $target_release ]] || { echo "Release $target_release not found" >&2; exit 1; }
  ln -s "$target_release" "$base/slots/${target_slot}.rollback"
  mv -Tf "$base/slots/${target_slot}.rollback" "$base/slots/${target_slot}"
else
  [[ -L "$base/slots/${target_slot}" ]] || { echo "No previous release bound to ${target_slot} slot; pass <SHA> explicitly" >&2; exit 1; }
  target_release=$(readlink -f "$base/slots/${target_slot}")
fi

systemctl restart "new-api@${target_slot}"
for attempt in $(seq 1 30); do
  if curl -fsS "http://127.0.0.1:${target_port}/api/status" | grep -q '"success":[[:space:]]*true'; then
    break
  fi
  sleep 2
done
curl -fsS "http://127.0.0.1:${target_port}/api/status" >/dev/null

upstream_conf=/etc/nginx/upstreams/new-api-upstream.conf
cat > "${upstream_conf}.next" <<EOF
# Managed by new-api-rollback (active: ${target_slot})
upstream new_api_backend {
    server 127.0.0.1:${target_port};
    keepalive 64;
}
EOF
chmod 0644 "${upstream_conf}.next"
mv -Tf "${upstream_conf}.next" "$upstream_conf"
nginx -t
systemctl reload nginx

printf '%s\n' "$target_slot" > "$base/active_slot"
ln -s "$target_release" "$base/current.rollback"
mv -Tf "$base/current.rollback" "$base/current"
systemctl enable "new-api@${target_slot}" >/dev/null 2>&1 || true

for drain_attempt in $(seq 1 45); do
  conns=$(ss -Htn state established "( sport = :${active_port} )" | wc -l)
  [[ $conns -eq 0 ]] && break
  sleep 2
done
systemctl stop "new-api@${active_slot}" || true
systemctl disable "new-api@${active_slot}" >/dev/null 2>&1 || true

printf 'Rolled back new-api to %s on %s slot (port %d)\n' "$target_release" "$target_slot" "$target_port"
