#!/usr/bin/env bash
set -euo pipefail
umask 077
mkdir -p /var/backups/new-api
file=/var/backups/new-api/$(date -u +%Y%m%dT%H%M%S)-${1:-scheduled}.dump
[[ ${1:-scheduled} =~ ^[a-zA-Z0-9-]+$ ]]
set -a
. /etc/new-api/pg.env
set +a
pg_dump -Fc > "$file.partial"
pg_restore --list "$file.partial" > /dev/null
mv "$file.partial" "$file"
find /var/backups/new-api -maxdepth 1 -name '*.dump' -mtime +14 -delete
