# /etc/tk-flywheel/app.env (chown root:tk-flywheel, chmod 0640)
# MODEL_MASTER_KEY must stay identical to DO-1's: it decrypts the model configs stored in the database.
APP_ORIGIN=https://flywheel.qingfan.app
LISTEN_ADDR=127.0.0.1:8087
STATIC_DIR=/opt/tk-flywheel/current/frontend/dist
HARNESS_WORKER=/opt/tk-flywheel/current/agent/run.mjs
MODEL_MASTER_KEY=<MODEL_MASTER_KEY>
EXECUTION_ENABLED=false
DATABASE_URL=postgres://tk_flywheel:<PASSWORD>@pgm-j6cd36m59smx6n9g.pg.cnhk.rds.aliyuncs.com:5432/tk_flywheel?sslmode=require
