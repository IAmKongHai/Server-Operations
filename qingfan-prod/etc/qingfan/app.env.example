# /etc/qingfan/app.env (chown root:qingfan, chmod 0640)
# Values other than the database URL and admin origin were copied from DO-1 at migration time.
QINGFAN_DATA=/var/lib/qingfan
QINGFAN_DATABASE_URL=postgres://qingfan:<PASSWORD>@pgm-j6cd36m59smx6n9g.pg.cnhk.rds.aliyuncs.com:5432/qingfan?sslmode=require
QINGFAN_ADMIN_ORIGIN=https://qingfan.app
QINGFAN_COLLECTOR_KEY=<COLLECTOR_KEY>
# Kept at 1 per pool after the move to RDS (see migration plan KTD7); raising it is a tuning change.
QINGFAN_DB_MAX_CONNS=1
QINGFAN_RUNNER_KEY=<RUNNER_KEY>
QINGFAN_TTS_URL=<TTS_URL>
QINGFAN_TTS_MODEL=<TTS_MODEL>
QINGFAN_TTS_KEY=<TTS_KEY>
QINGFAN_PRODUCTION_OSS_KEY_ID=<OSS_KEY_ID>
QINGFAN_PRODUCTION_OSS_KEY_SECRET=<OSS_KEY_SECRET>
