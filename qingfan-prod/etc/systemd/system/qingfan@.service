# Template unit for Blue-Green deployment: qingfan@blue.service (:8090) / qingfan@green.service (:8091)
[Unit]
Description=Qingfan server (%i slot): website, downloads, admin and desktop API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qingfan
Group=qingfan
WorkingDirectory=/var/lib/qingfan
EnvironmentFile=/etc/qingfan/app.env
EnvironmentFile=/etc/qingfan/slot-%i.env
# Loopback only; nginx terminates HTTPS in front of it.
ExecStart=/opt/qingfan/slots/%i/qingfan-server -addr ${QINGFAN_ADDR}
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/qingfan

[Install]
WantedBy=multi-user.target
