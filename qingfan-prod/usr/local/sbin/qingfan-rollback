#!/usr/bin/env bash
# Instant Blue-Green rollback for Qingfan: switches back to the other slot or a specified <version>.
set -euo pipefail
umask 022

exec 9>/run/lock/qingfan-deploy.lock
flock -n 9 || { echo "另一个青帆操作正在运行" >&2; exit 1; }

base=/opt/qingfan
active_slot=$(tr -d '[:space:]' < "$base/active_slot" 2>/dev/null || echo "blue")

if [[ $active_slot == "blue" ]]; then
  target_slot="green"
  target_port=8091
  active_port=8090
else
  target_slot="blue"
  target_port=8090
  active_port=8091
fi

if [[ -n ${1:-} ]]; then
  target_release="$base/releases/$1"
  [[ -d $target_release ]] || { echo "版本目录不存在：$target_release" >&2; exit 1; }
  ln -sfn "$target_release" "$base/slots/${target_slot}.rollback"
  mv -Tf "$base/slots/${target_slot}.rollback" "$base/slots/${target_slot}"
else
  [[ -L "$base/slots/${target_slot}" ]] || { echo "备用槽位 ${target_slot} 未绑定版本，请显式传入版本号" >&2; exit 1; }
  target_release=$(readlink -f "$base/slots/${target_slot}")
fi

systemctl restart "qingfan@${target_slot}"
for _ in $(seq 30); do
  if curl -fsS -o /dev/null "http://127.0.0.1:${target_port}/healthz"; then
    break
  fi
  sleep 1
done
curl -fsS -o /dev/null "http://127.0.0.1:${target_port}/healthz"

ln -sfn "$target_release" "$base/current.rollback"
mv -Tf "$base/current.rollback" "$base/current"

upstream_conf=/etc/nginx/upstreams/qingfan-upstream.conf
cat > "${upstream_conf}.next" <<EOF
# Managed by qingfan-rollback (active: ${target_slot})
upstream qingfan_backend {
    server 127.0.0.1:${target_port};
    keepalive 32;
}
EOF
chmod 0644 "${upstream_conf}.next"
mv -Tf "${upstream_conf}.next" "$upstream_conf"
nginx -t -q
systemctl reload nginx

printf '%s\n' "$target_slot" > "$base/active_slot"
systemctl enable "qingfan@${target_slot}" >/dev/null 2>&1 || true

for _ in $(seq 1 60); do
  conns=$(ss -Htn state established "( sport = :${active_port} )" | wc -l)
  [[ $conns -eq 0 ]] && break
  sleep 2
done
systemctl stop "qingfan@${active_slot}" || true
systemctl disable "qingfan@${active_slot}" >/dev/null 2>&1 || true

printf '已回滚青帆到 %s (%s 槽位, 端口 %d)\n' "$(basename "$target_release")" "$target_slot" "$target_port"
