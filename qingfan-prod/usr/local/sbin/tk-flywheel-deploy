#!/usr/bin/env bash
# Root-owned forced SSH command: accepts a release archive only, never a shell.
set -euo pipefail
umask 077
[[ ${SSH_ORIGINAL_COMMAND:-} =~ ^deploy\ ([0-9a-f]{40})$ ]] || { echo 'Expected deploy <commit SHA>' >&2; exit 1; }
sha=${BASH_REMATCH[1]}
exec 9>/run/lock/tk-flywheel-deploy.lock
flock -n 9 || { echo 'Another deployment is running' >&2; exit 1; }
base=/opt/tk-flywheel
release=$base/releases/$sha
[[ ! -e $release ]] || { echo 'Release already exists; inspect before retrying' >&2; exit 1; }
archive=$(mktemp)
trap 'rm -f "$archive"' EXIT
cat > "$archive"
[[ $(stat -c %s "$archive") -lt 536870912 ]]
install -d -o tk-flywheel -g tk-flywheel -m 755 "$release"
chown tk-flywheel:tk-flywheel "$archive"
# Extract as the application user, with Python's data filter rejecting traversal and unsafe links.
runuser -u tk-flywheel -- python3 - "$archive" "$release" <<'PY'
import sys, tarfile
with tarfile.open(sys.argv[1]) as archive:
    archive.extractall(sys.argv[2], filter='data')
PY
# The application user may read and run the release but never rewrite it.
chown -R root:tk-flywheel "$release"
chmod -R g+rX,g-w,o-rwx "$release"
[[ $(cat "$release/frontend/dist/version.txt") == "$sha" ]]
runuser -u tk-flywheel -- "$release/bin/node" --version
previous=''
if [[ -L $base/current ]]; then
  previous=$(readlink -f "$base/current")
fi
/usr/local/sbin/tk-flywheel-backup "pre-$sha"
# No user or model credentials are passed on the command line or printed.
systemd-run --quiet --wait --pipe --unit="tk-flywheel-migrate-$sha" \
  -p User=tk-flywheel -p Group=tk-flywheel -p EnvironmentFile=/etc/tk-flywheel/app.env \
  "$release/backend/flywheel" migrate
ln -s "$release" "$base/current.next"
mv -Tf "$base/current.next" "$base/current"
systemctl restart tk-flywheel || true
healthy=false
for attempt in $(seq 1 30); do
  if curl -fsS http://127.0.0.1:8087/healthz >/dev/null && \
     [[ $(curl -fsS http://127.0.0.1:8087/version.txt) == "$sha" ]]; then
    healthy=true
    break
  fi
  sleep 2
done
if [[ $healthy != true ]]; then
  if [[ -n $previous && -d $previous ]]; then
    ln -s "$previous" "$base/current.rollback"
    mv -Tf "$base/current.rollback" "$base/current"
    systemctl restart tk-flywheel
    curl --retry 10 --retry-connrefused --retry-delay 2 -fsS http://127.0.0.1:8087/healthz >/dev/null
  else
    systemctl stop tk-flywheel
  fi
  echo 'Release health check failed; previous application restored if available. Database was not downgraded.' >&2
  exit 1
fi
printf 'Deployed %s\n' "$sha"
