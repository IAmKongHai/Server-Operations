# /etc/logrotate.d/nyh —— 替代宝塔「切割日志」计划任务
# nginx 站点日志（宝塔每天切割、保留 180 份；这里保留 30 天，旧机的历史日志不迁移）
/www/wwwlogs/*.log {
    daily
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    dateext
    sharedscripts
    postrotate
        [ -f /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)"
    endscript
}

# 业务定时任务日志（/etc/cron.d/nyh-tasks）
/var/log/nyh-cron/*.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
}
