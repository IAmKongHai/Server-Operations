# /opt/stacks/new-api/.env 的模板（服务器上 root 600，真实值不入库；本机备份在 nyh-prod-2026/secrets.local.md）
# 同一个文件既给 compose 做变量替换（NEWAPI_REDIS_UID/GID），也作为 new-api 容器的 env_file。

# --- compose 变量 ---
NEWAPI_REDIS_UID=<id -u newapi-redis>
NEWAPI_REDIS_GID=<id -g newapi-redis>

# --- 数据库：RDS PG（内网域名，在本机解析为 172.31.x）---
SQL_DSN=postgres://new_api_user:<密码>@pgm-j6cf5kaej216sx0z.pg.cnhk.rds.aliyuncs.com:5432/new_api?sslmode=disable
# RDS 是 2C4G、max_connections 400，多个项目共用；new-api 默认 1000 连接上限，必须收紧
SQL_MAX_OPEN_CONNS=40
SQL_MAX_IDLE_CONNS=10

REDIS_CONN_STRING=redis://:<redis 密码>@new-api-redis:6379/0

# --- 密钥：首次部署即固定，不要轮换 ---
# CRYPTO_SECRET 加密渠道密钥、签发视频结果的下载链接；换掉会让已存渠道密钥解不开、已发链接全部失效
SESSION_SECRET=<64 位 hex>
CRYPTO_SECRET=<64 位 hex>

# --- 经 nginx HTTPS 访问 ---
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://tovo.sh
# nginx 在宿主机，经 docker-proxy 进容器，来源是 docker 网关（daemon.json 地址池 10.210.0.0/16）
TRUSTED_PROXIES=127.0.0.1/32,10.210.0.0/16,172.17.0.0/16

# --- 其它 ---
TZ=Asia/Shanghai
DEFAULT_LANGUAGE=zh-CN
NODE_NAME=nyh-prod-2026
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
STREAMING_TIMEOUT=300
